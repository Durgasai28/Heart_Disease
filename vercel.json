{
  "version": 2,
  "rewrites": [
    {
      "source": "/predict/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/features",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/stylesheet_ids.css",
      "destination": "/frontend/stylesheet_ids.css"
    },
    {
      "source": "/heartbg.jpg",
      "destination": "/frontend/heartbg.jpg"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
